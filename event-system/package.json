{
  "name": "event-system-root",
  "version": "1.0.0",
  "description": "Event Registration & Venue Scheduling System - Woxsen University DBMS Project 31",
  "private": true,
  "scripts": {
    "db:setup": "node db/apply.js",
    "server": "node server/index.js",
    "client": "npm run dev --prefix client",
